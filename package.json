{
  "name": "dsh-mail",
  "version": "0.1.0",
  "private": true,
  "description": "Rule-driven email tasks and replies for DeepSeek Harness",
  "type": "module",
  "license": "LGPL-3.0-or-later",
  "engines": {
    "bun": ">=1.4.4",
    "node": "^24.9.0 || >=26.0.0",
    "dsh": ">=0.2.2-alpha.2 <0.3.0-0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client-types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./typert": {
      "types": "./lib/typert.d.ts",
      "default": "./lib/typert.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "examples",
    "patches",
    "docs",
    "src",
    "tsconfig.json",
    "tsconfig.client.json",
    "LICENSE",
    "COPYING",
    "COPYING.LESSER",
    "NOTICE",
    "scripts/build.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "bun --bun tsc -p tsconfig.check.json --noEmit && bun --bun tsc -p tsconfig.client.json --noEmit",
    "test": "bun test --timeout 30000 ./tests",
    "check": "bun run build && bun run typecheck && bun run test",
    "test:integration": "bun test ./tests/transport.test.ts ./tests/profile.test.ts",
    "test:core": "bun test ./tests/core.test.ts ./tests/signature.test.ts",
    "test:compat": "bun run scripts/compatibility.ts"
  },
  "dependencies": {
    "email-reply-parser": "2.3.9",
    "imapflow": "2.10.0",
    "js-yaml": "5.5.0",
    "mailauth": "8.0.4",
    "mailparser": "3.14.1",
    "markdown-it": "15.0.3",
    "node-pop3": "0.15.3",
    "nodemailer": "10.3.1",
    "proper-lockfile": "4.1.2",
    "sanitize-html": "2.18.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.6-alpha.1 <5",
    "@deepseek-ai/dsh-agent": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-brand": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-permission-presets": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-title": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.2-alpha.2 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.6-alpha.1 <4",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-alpha.2 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-permission-presets": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-sqlite": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/bun": "1.4.4",
    "@types/js-yaml": "4.0.9",
    "@types/mailparser": "3.9.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/sanitize-html": "2.16.2",
    "@types/smtp-server": "3.5.13",
    "hoodiecrow-imap": "3.3.0",
    "immer": "10.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "selfsigned": "5.5.0",
    "smtp-server": "3.21.3",
    "typescript": "7.0.2",
    "zustand": "4.5.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iMMIQ/dsh-mail.git"
  },
  "homepage": "https://github.com/iMMIQ/dsh-mail#readme",
  "bugs": {
    "url": "https://github.com/iMMIQ/dsh-mail/issues"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "node-pop3@0.15.3": "patches/node-pop3@0.15.3.patch"
  }
}
