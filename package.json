{
  "name": "dsh-mail",
  "version": "0.1.0",
  "private": true,
  "description": "Rule-driven email tasks and replies for DeepSeek Harness",
  "type": "module",
  "license": "LGPL-3.0-or-later",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24.9.0",
    "dsh": "0.2.2-alpha.2"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "examples",
    "docs",
    "src",
    "tsconfig.json",
    "LICENSE",
    "COPYING",
    "COPYING.LESSER",
    "NOTICE",
    "scripts/build.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "bun --bun tsc -p tsconfig.check.json --noEmit",
    "test": "bun test ./tests",
    "check": "bun run build && bun run typecheck && bun run test",
    "test:integration": "bun test ./tests/transport.test.ts ./tests/profile.test.ts",
    "test:core": "bun test ./tests/core.test.ts ./tests/signature.test.ts"
  },
  "dependencies": {
    "imapflow": "2.10.0",
    "js-yaml": "5.5.0",
    "mailauth": "8.0.4",
    "mailparser": "3.14.1",
    "nodemailer": "10.3.1",
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-brand": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-permission-presets": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-title": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-workspace": "0.2.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-storage-sqlite": "0.2.2-alpha.2",
    "@types/js-yaml": "4.0.9",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/smtp-server": "3.5.13",
    "hoodiecrow-imap": "3.3.0",
    "selfsigned": "5.5.0",
    "smtp-server": "3.21.3",
    "typescript": "7.0.2",
    "@types/bun": "1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iMMIQ/dsh-mail.git"
  },
  "homepage": "https://github.com/iMMIQ/dsh-mail#readme",
  "bugs": {
    "url": "https://github.com/iMMIQ/dsh-mail/issues"
  },
  "packageManager": "bun@1.4.4"
}
