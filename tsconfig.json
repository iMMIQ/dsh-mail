{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "lib",
    "rootDir": "src",
    "types": [
      "bun"
    ],
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "ESNext.RegExp"
    ]
  },
  "include": [
    "src/*.ts"
  ]
}
